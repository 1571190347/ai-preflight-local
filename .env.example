# AI 体检站 v0.3.0：复制为 .env 后按需填写；无需配置也能启动。
# 只分享本示例，不分享包含真实密钥的 .env。

# 本机运行；主应用的 Docker Compose 负责容器内监听配置。
PORT=4173
BIND_ADDRESS=127.0.0.1
CONFIG_FILE=config.local.json

# 可选 IP 数据源密钥。留空表示未配置；不要使用 VITE_ 前缀。
IPAPI_KEY=
ABUSEIPDB_KEY=

# 可选 Globalping 令牌；公共测量仍可能公开，不会因此变为私有。
GLOBALPING_TOKEN=

# 可选自建 DNS 收集器：基础地址必须是标准 HTTPS、无查询参数和凭据。
# DNS_COLLECTOR_URL=https://dns-api.example.com
DNS_COLLECTOR_URL=
DNS_COLLECTOR_TOKEN=

# 只有添加 config.local.json 的 pingNodes 后才使用。
# 变量名必须与该节点的 tokenEnv 一致，值与自己节点的令牌一致。
PING_NODE_MY_TOKEN=

# auto: 仅对系统 Fake-IP 回退 Cloudflare DoH；system: 禁用；doh: 使用公共 DoH。
# 只在主动运行后台操作时查询；Cloudflare 会接收被查询域名。
DNS_MODE=auto
